# Copy to .env and replace the placeholder before starting Docker Compose.
CINEVAULT_PORT=8081
CINEVAULT_BIND_HOST=127.0.0.1
CINEVAULT_ADMIN_TOKEN=replace-with-a-long-random-secret
# Leave empty while the service is private behind an SSH tunnel. Do not put a
# viewer token into browser JavaScript; add HTTPS reverse-proxy auth before
# publishing the app.
CINEVAULT_VIEWER_TOKEN=
CINEVAULT_TMDB_API_TOKEN=
CINEVAULT_API_BASE_URL=
CINEVAULT_PUBLIC_URL=
CINEVAULT_CORS_ORIGINS=
CINEVAULT_DATA_DIR=./data/media-library
CINEVAULT_INBOX_DIR=./inbox
# Local-only Kinopoisk card/source refresh. The default is the matching
# checkout under ~/PycharmProjects/parsers; set this when it lives elsewhere.
CINEVAULT_KINOPOISK_UPDATER_DIR=
CINEVAULT_KINOPOISK_UPDATE_INTERVAL_SECONDS=3600
CINEVAULT_KINOPOISK_UPDATE_DELAY_SECONDS=7
CINEVAULT_APBUGALL_TOKEN=
CINEVAULT_DEVICE_FP=
CINEVAULT_IFRAME_REQUEST_ID=
